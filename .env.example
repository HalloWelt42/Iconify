# Iconify – Beispiel-Konfiguration
# Kopiere diese Datei nach ".env" und passe die Werte an. Alle Variablen
# sind optional; ohne .env gelten die Defaults aus app/config.py.

# --- Server ---
ICONIFY_HOST=0.0.0.0
ICONIFY_PORT=8766
ICONIFY_DEBUG=false

# --- Downloads (Icon-Import) ---
ICONIFY_MAX_CONCURRENT_DOWNLOADS=20
ICONIFY_DOWNLOAD_TIMEOUT=120
ICONIFY_CONNECT_TIMEOUT=15
ICONIFY_READ_TIMEOUT=90
ICONIFY_METADATA_TIMEOUT=180

# Optionaler GitHub-Token: erhöht das API-Rate-Limit beim Import von
# GitHub-basierten Sets (sonst 60 Anfragen/Stunde). Nur lesender Zugriff nötig.
# ICONIFY_GITHUB_TOKEN=
